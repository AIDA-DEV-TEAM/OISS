# Environment variables read by the OISS backend. Names only; never commit values.
#
# Nothing loads this file automatically: export these in the shell (or your
# process manager) before starting `uvicorn app.api.main:app`.

# Base URL of the external crop-yield model service (prompt 7). The sandbox
# adapter calls it server-side; the browser never does.
# Unset, it defaults to http://127.0.0.1:8000.
MODEL_API_BASE_URL=

# --------------------------------------------------------------------------
# Language model for the analytics assistant (RFP area 5)
#
# With no key set the app still runs: starter questions answer from the
# response cache committed under data/llm_cache/, and a new question is
# reported as "could not be interpreted right now" instead of being guessed at.
# --------------------------------------------------------------------------

# Which hosted provider to call. Only "gemini" is implemented; any other value
# runs on the cache alone. Unset, it defaults to gemini.
LLM_PROVIDER=

# Model name passed to the provider. Unset, it defaults to gemini-2.5-flash.
LLM_MODEL=

# API key for the provider. Secret: set it in the shell, never in a file in
# the repo. Sent only to the provider, in a request header.
LLM_API_KEY=

# Seconds to wait for the provider before giving up. Unset, it defaults to 20.
LLM_TIMEOUT_SECONDS=

# Where responses are cached by a hash of their input. Unset, it defaults to
# data/llm_cache (committed, so the starter questions work offline).
LLM_CACHE_DIR=
